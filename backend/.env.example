# ---------------------------------------------------------------------------
# LensLoop backend — copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Homebrew:  postgresql://<your-macos-user>@localhost:5432/rentino
# Docker:    postgresql://rentino:rentino@localhost:5432/rentino
DATABASE_URL="postgresql://rentino:rentino@localhost:5432/rentino?schema=public"

# Separate database used only by the e2e test suite (NEVER your dev database).
TEST_DATABASE_URL="postgresql://rentino:rentino@localhost:5432/rentino_test?schema=public"

# HTTP port the API listens on.
PORT=8000

# Node environment: development | production | test
NODE_ENV=development

# JWT secrets — replace with long random strings, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS="http://localhost:3000"

# Base URL of the frontend, used to build simulated-payment redirect URLs.
FRONTEND_URL="http://localhost:3000"

# Base URL the API is reachable at, used by the simulated payment gateway page.
API_PUBLIC_URL="http://localhost:8000"

# Expose Swagger docs. Set to "false" in production.
SWAGGER_ENABLED=true
