# ---------------------------------------------------------------------------
# LensLoop (رنتینو) frontend — copy to `.env.local` and adjust if needed.
# ---------------------------------------------------------------------------

# Base URL of the backend API, including the version prefix.
# The backend runs on port 8000 and serves every route under /api/v1.
#   npm run start:dev   (in backend/)  ->  http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: Google sign-in is NOT implemented in this project. The button only
# renders when this is set, and the backend answers 501 for /auth/google.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
